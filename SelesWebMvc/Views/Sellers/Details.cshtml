@model SelesWebMvc.Models.Seller

@{
    ViewData["Title"] = "Seller Details";
}

<h2>Details</h2>

<div>
    <h4>Seller</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Birth Date</dt>
        <dd class="col-sm-10">@Model.BirthDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Base Salary</dt>
        <dd class="col-sm-10">@Model.BaseSalary</dd>

        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.Department.Name</dd>
    </dl>
</div>

<form asp-action="Delete">
    <button type="submit" class="btn btn-default">Edit</button>
    <a asp-action="Index" class"">Back to list</a>
</form>
